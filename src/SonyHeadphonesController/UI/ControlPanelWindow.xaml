<Window x:Class="SonyCtrl.UI.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sony 耳机控制"
        Width="300" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Text styles; each grays out when the enclosing disconnected section disables it -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChargingText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#666"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Entrance animation runs in code-behind on every Show (Loaded only fires once).
             RenderTransform is rebuilt per Show because Setter-created values are frozen. -->
        <Style x:Key="FlyoutCard" TargetType="Border"/>

        <!-- ANC three-state buttons; Tag=true marks the active mode, smooth hover/press transitions.
             Background comes from TemplateBinding so the active-state DataTrigger (blue) can take effect;
             hover/press darken via a black shade overlay that works on both gray and blue states. -->
        <Style x:Key="AncButton" TargetType="Button">
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Shade" CornerRadius="6" Background="Black"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.12">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState Name="Normal"/>
                                    <VisualState Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shade"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.08" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shade"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.16" Duration="0:0:0.04"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ambient level slider: modern bar look — rounded 10px track, blue rounded fill,
             no grab knob (the thumb is an invisible drag hit-area with an arrow cursor).
             Value commit moved to a ValueChanged debounce in code-behind (no DragCompleted
             without a visible thumb). -->
        <Style x:Key="BarSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBg" Height="10" CornerRadius="5"
                                    Background="#E4E4E4" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="Fill" Height="10" CornerRadius="5"
                                                        Background="#0078D4" VerticalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Fill" Property="Background" Value="#C9C9C9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <!-- Invisible drag hit-area; its height sizes the Track,
                                         so it must match the slider height. No grab knob. -->
                                    <Thumb Cursor="Arrow">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="20" Background="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TrackBg" Property="Background" Value="#EFEFEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Panel card: drop shadow + rounded corners for depth layering -->
    <Border x:Name="Card" Style="{StaticResource FlyoutCard}"
            Background="#F2FFFFFF"
            CornerRadius="10"
            BorderBrush="#1A000000"
            BorderThickness="1"
            Padding="18"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.38"/>
        </Border.Effect>
        <StackPanel>

            <!-- Product image (official Sound Connect asset, background removed) -->
            <Image Source="Assets/xm5_black.png" Height="88" Stretch="Uniform"
                   HorizontalAlignment="Center" Margin="0,0,0,10"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Header: device name + connection state -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DeviceName}"
                           FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding StateText}"
                           FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
            </Grid>

            <!-- Unresponsive banner (top, above all content) -->
            <Border Background="#33D32F2F" CornerRadius="6" Padding="8" Margin="0,10,0,0"
                    Visibility="{Binding IsUnresponsive, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="耳机无响应" Foreground="#D32F2F" FontSize="12" HorizontalAlignment="Center"/>
            </Border>

            <!-- Device state section: grayed out and non-interactive while disconnected -->
            <Grid IsEnabled="{Binding IsConnected}" Margin="0,10,0,0">
                <StackPanel>

                    <!-- Battery -->
                    <TextBlock Text="电量" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="左耳" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BatteryLeftText}" Style="{StaticResource ValueText}"/>
                                <TextBlock Text="充电中" Style="{StaticResource ChargingText}" VerticalAlignment="Bottom" Margin="3,0,0,3"
                                           Visibility="{Binding LeftChargingVisible}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="右耳" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BatteryRightText}" Style="{StaticResource ValueText}"/>
                                <TextBlock Text="充电中" Style="{StaticResource ChargingText}" VerticalAlignment="Bottom" Margin="3,0,0,3"
                                           Visibility="{Binding RightChargingVisible}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="充电盒" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BatteryCaseText}" Style="{StaticResource ValueText}"/>
                                <TextBlock Text="充电中" Style="{StaticResource ChargingText}" VerticalAlignment="Bottom" Margin="3,0,0,3"
                                           Visibility="{Binding CaseChargingVisible}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ANC three-state: implicit per-button Style with DataTrigger for active highlight -->
                    <TextBlock Text="噪声控制" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                    <UniformGrid Columns="3">
                        <Button Content="降噪" Margin="0,0,6,0"
                                Command="{Binding SetAncCommand}" CommandParameter="NoiseCancelling">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource AncButton}">
                                    <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsNoiseCancelling}" Value="True"/>
                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#0078D4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="通透" Margin="0,0,6,0"
                                Command="{Binding SetAncCommand}" CommandParameter="AmbientSound">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource AncButton}">
                                    <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAmbientSound}" Value="True"/>
                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#0078D4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="关闭"
                                Command="{Binding SetAncCommand}" CommandParameter="Off">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource AncButton}">
                                    <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAncOff}" Value="True"/>
                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#0078D4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </UniformGrid>

                    <!-- Ambient level slider: bar style, commit debounced in code-behind -->
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="通透等级" Style="{StaticResource SmallText}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AmbientLevelText}" Style="{StaticResource SmallText}"/>
                        </Grid>
                        <Slider Grid.Row="1" x:Name="AmbientSlider" Style="{StaticResource BarSlider}"
                                Minimum="0" Maximum="20"
                                Value="{Binding AmbientLevel}"
                                IsEnabled="{Binding AmbientLevelEnabled}"
                                Margin="0,6,0,0"
                                ValueChanged="OnAmbientSliderChanged"/>
                    </Grid>

                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</Window>
