<Window x:Class="SonyCtrl.UI.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonyCtrl.UI"
        Title="Sony 耳机控制"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="300" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:AncSegmentTextConverter x:Key="AncSegmentText"/>

        <!-- Text styles; each grays out when the enclosing disconnected section disables it -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChargingText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#666"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#C4C4C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Global text style: subtle dark halo under every label keeps text readable
             even where the pinned frosted backdrop happens to sit dark. -->
        <Style TargetType="TextBlock">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Entrance animation runs in code-behind on every Show (Loaded only fires once).
             RenderTransform is rebuilt per Show because Setter-created values are frozen. -->
        <Style x:Key="FlyoutCard" TargetType="Border"/>

        <!-- ANC segmented-slider segment: a bare transparent hit area over the shared
             track. No hover/press visuals on purpose — feedback comes from the knob
             sliding to the selected segment, so a second visual layer would fight the
             slider metaphor. Without this template the default WPF Button chrome
             (blue hover fill) would show through. The Border with a Transparent brush
             is what makes the WHOLE segment clickable: a bare ContentPresenter only
             hit-tests where it actually draws (the text), leaving the rest of the
             segment dead. Transparent (unlike null) is hit-testable in WPF. -->
        <Style x:Key="AncSegmentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- Mouse-driven flyout: the dotted keyboard-focus rectangle that WPF draws
                 after a click reads as visual noise here. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ANC segmented slider: frosted track with a sliding knob. Clicking a label
             jumps the knob (and fires the command); the knob itself is decorative so
             dragging is unnecessary — the ANC state is a discrete three-way choice,
             not a scrub value. -->
        <Style x:Key="AncSegment" TargetType="Grid">
            <Setter Property="Height" Value="34"/>
        </Style>

        <!-- Ambient level slider: modern bar look — rounded 10px track, blue rounded fill,
             no grab knob. The fill is an overlay sized by value fraction (a Track-based fill
             always stops one thumb-width short of the end), and mouse input is handled on
             the panel itself: press anywhere jumps to that position, drag scrubs. Value
             commit stays in the ValueChanged debounce in code-behind. -->
        <Style x:Key="BarSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBg" Height="10" CornerRadius="5"
                                    Background="#30FFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="Fill" Height="10" CornerRadius="5"
                                    Background="#666666" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" Width="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TrackBg" Property="Background" Value="#20FFFFFF"/>
                                <Setter TargetName="Fill" Property="Background" Value="#C9C9C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Voice-focus toggle: compact switch matching the panel's rounded language.
             All on/off transitions (knob slide + on-track cross-fade) are driven from
             code-behind, mirroring the ANC segmented knob: trigger-setter approaches kept
             fighting the animation's held value (the knob snapped back to whichever side
             the local transform value was left at). -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="ToggleRoot" Width="36" Height="20">
                            <Border x:Name="TrackOff" CornerRadius="10"
                                    Background="#40FFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="TrackOn" CornerRadius="10"
                                    Background="#4D4D4D" VerticalAlignment="Center" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TrackOff" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Panel card: drop shadow + rounded corners for depth layering.
         Background is a frosted-glass snapshot laid in by code-behind (screen region
         behind the card, gaussian-blurred + adaptively lifted toward white so the gray
         label text keeps contrast); this fallback shows until capture succeeds. -->
    <Border x:Name="Card" Style="{StaticResource FlyoutCard}"
            Background="#E6FFFFFF"
            CornerRadius="16"
            BorderBrush="#1A000000"
            BorderThickness="1"
            Padding="18"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.38"/>
        </Border.Effect>
        <StackPanel>

            <!-- Product image (official Sound Connect asset, background removed);
                 source follows the colour byte the device reports -->
            <Image Source="{Binding ProductImageSource}" Height="88" Stretch="Uniform"
                   HorizontalAlignment="Center" Margin="0,16,0,18"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Header: device name + connection state -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DeviceName}"
                           FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding StateText}"
                           FontSize="11" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#888"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="#3D8B5F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Unresponsive banner (top, above all content) -->
            <Border Background="#33D32F2F" CornerRadius="6" Padding="8" Margin="0,10,0,0"
                    Visibility="{Binding IsUnresponsive, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="耳机无响应" Foreground="#D32F2F" FontSize="12" HorizontalAlignment="Center"/>
            </Border>

            <!-- Device state section: grayed out and non-interactive while disconnected -->
            <Grid IsEnabled="{Binding IsConnected}" Margin="0,10,0,0">
                <StackPanel>

                    <!-- Battery -->
                    <TextBlock Text="电量" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="左耳" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BatteryLeftText}" Style="{StaticResource ValueText}"/>
                                <TextBlock Text="充电中" Style="{StaticResource ChargingText}" VerticalAlignment="Bottom" Margin="3,0,0,3"
                                           Visibility="{Binding LeftChargingVisible}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="右耳" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BatteryRightText}" Style="{StaticResource ValueText}"/>
                                <TextBlock Text="充电中" Style="{StaticResource ChargingText}" VerticalAlignment="Bottom" Margin="3,0,0,3"
                                           Visibility="{Binding RightChargingVisible}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="充电盒" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BatteryCaseText}" Style="{StaticResource ValueText}"/>
                                <TextBlock Text="充电中" Style="{StaticResource ChargingText}" VerticalAlignment="Bottom" Margin="3,0,0,3"
                                           Visibility="{Binding CaseChargingVisible}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ANC three-state: segmented slider — iOS-style: track and knob share
                         the same height (knob inset 3px), the knob fills a full segment so
                         the selected label sits on solid accent colour. -->
                    <TextBlock Text="噪声控制" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                    <Grid x:Name="AncContainer" Height="36" IsEnabled="{Binding IsConnected}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <!-- Dim the whole widget when disconnected: the knob and
                                         track are not children of the enabled-state grid, so
                                         the inherited IsEnabled grey-out cannot reach them. -->
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border CornerRadius="9"
                                Background="#4DFFFFFF"
                                BorderBrush="#26000000" BorderThickness="1"/>
                        <!-- Knob: one full segment wide (inset 3px each side), positioned by code-behind -->
                        <Border x:Name="AncKnob" Height="30" CornerRadius="7"
                                Background="#4D4D4D" HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                Margin="0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.18"/>
                            </Border.Effect>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="降噪"
                                    Style="{StaticResource AncSegmentButton}"
                                    Command="{Binding SetAncCommand}" CommandParameter="NoiseCancelling"
                                    Foreground="{Binding IsNoiseCancelling, Converter={StaticResource AncSegmentText}}"/>
                            <Button Grid.Column="1" Content="通透"
                                    Style="{StaticResource AncSegmentButton}"
                                    Command="{Binding SetAncCommand}" CommandParameter="AmbientSound"
                                    Foreground="{Binding IsAmbientSound, Converter={StaticResource AncSegmentText}}"/>
                            <Button Grid.Column="2" Content="关闭"
                                    Style="{StaticResource AncSegmentButton}"
                                    Command="{Binding SetAncCommand}" CommandParameter="Off"
                                    Foreground="{Binding IsAncOff, Converter={StaticResource AncSegmentText}}"/>
                        </Grid>
                    </Grid>

                    <!-- Ambient level slider: bar style, commit debounced in code-behind -->
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="通透等级" Style="{StaticResource SmallText}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AmbientLevelText}" Style="{StaticResource SmallText}"/>
                        </Grid>
                        <Slider Grid.Row="1" x:Name="AmbientSlider" Style="{StaticResource BarSlider}"
                                Minimum="0" Maximum="20"
                                Value="{Binding AmbientLevel}"
                                IsEnabled="{Binding AmbientLevelEnabled}"
                                Margin="0,6,0,0"/>
                    </Grid>

                    <!-- Voice focus (Sound Connect「关注语音」): only meaningful in Ambient
                         mode, grayed out alongside the level slider otherwise -->
                    <Grid IsEnabled="{Binding VoiceFocusEnabled}" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="关注语音" Style="{StaticResource SmallText}"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding IsVoiceFocus}"/>
                    </Grid>

                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</Window>
