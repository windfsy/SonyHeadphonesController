<Application x:Class="SonyCtrl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Tray icon as a global resource: instantiated at startup independent of any Window,
             per H.NotifyIcon's recommended pattern for apps without a visible main window. -->
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="Sony 耳机控制器"/>
    </Application.Resources>
</Application>
